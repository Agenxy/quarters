{
  "name": "quarters-cli",
  "version": "0.1.0-alpha.4",
  "description": "Persistent alternate user-state profiles for native processes",
  "license": "GPL-3.0-or-later",
  "packageManager": "bun@1.4.4",
  "type": "module",
  "bin": {
    "quarters": "dist/src/quarters.js"
  },
  "files": [
    "dist/src/*.js",
    "man/*.1",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "man": [
    "./man/quarters-adapter.1",
    "./man/quarters-agent.1",
    "./man/quarters-clone.1",
    "./man/quarters-create.1",
    "./man/quarters-current.1",
    "./man/quarters-discover.1",
    "./man/quarters-doctor.1",
    "./man/quarters-enter.1",
    "./man/quarters-env.1",
    "./man/quarters-exec.1",
    "./man/quarters-export-key.1",
    "./man/quarters-export.1",
    "./man/quarters-freeze.1",
    "./man/quarters-host.1",
    "./man/quarters-import.1",
    "./man/quarters-list.1",
    "./man/quarters-mcp.1",
    "./man/quarters-recover.1",
    "./man/quarters-rename.1",
    "./man/quarters-rm.1",
    "./man/quarters-rollback.1",
    "./man/quarters-shell-init.1",
    "./man/quarters-shortcut.1",
    "./man/quarters-snapshot.1",
    "./man/quarters-status.1",
    "./man/quarters-template.1",
    "./man/quarters-unfreeze.1",
    "./man/quarters-upgrade.1",
    "./man/quarters.1"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Agenxy/quarters.git",
    "directory": "packaging/npm/quarters-cli"
  },
  "homepage": "https://github.com/Agenxy/quarters",
  "bugs": {
    "url": "https://github.com/Agenxy/quarters/issues"
  },
  "keywords": [
    "cli",
    "environment",
    "profile",
    "shell",
    "userspace"
  ],
  "optionalDependencies": {
    "quarters-cli-darwin-arm64": "0.1.0-alpha.4",
    "quarters-cli-darwin-x64": "0.1.0-alpha.4",
    "quarters-cli-linux-arm64": "0.1.0-alpha.4",
    "quarters-cli-linux-x64": "0.1.0-alpha.4"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "check": "bun run typecheck && bun run test",
    "prepack": "bun run build",
    "test": "bun run build && node --test dist/test/*.test.js",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  }
}
